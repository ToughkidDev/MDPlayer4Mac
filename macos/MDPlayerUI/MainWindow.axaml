<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MDPlayer.UI.MainWindow"
        Title="MDPlayer4Mac"
        Width="740" Height="260"
        CanResize="False">
    <StackPanel Margin="16" Spacing="12">
        <TextBlock x:Name="FileLabel" Text="파일을 선택하세요" FontWeight="Bold" TextWrapping="Wrap" />
        <TextBlock x:Name="StatusLabel" Text="대기 중" Foreground="Gray" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="OpenButton" Content="VGM 열기..." Click="OnOpenClick" />
            <Button x:Name="PlayButton" Content="재생" Click="OnPlayClick" IsEnabled="False" />
            <Button x:Name="StopButton" Content="정지" Click="OnStopClick" IsEnabled="False" />
        </StackPanel>
        <!--
          Chip channel visualizer(s) get docked here at runtime (see MainWindow.axaml.cs's
          ShowVisualizerFor/HideVisualizers) - one PixelScreen control per active chip this
          port has a visualizer for (currently just SN76489; see macos/README.md). Black
          background matches the sprite art's own black background so any native-size
          rounding/gaps at the control's edges aren't visually jarring.
        -->
        <Border Background="Black" BorderBrush="Gray" BorderThickness="1" Padding="4">
            <StackPanel x:Name="VisualizerHost" Spacing="4" />
        </Border>
    </StackPanel>
</Window>
