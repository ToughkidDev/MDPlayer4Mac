<Project Sdk="Microsoft.NET.Sdk">

  <!--
    First GUI milestone for the macOS port: a minimal Avalonia desktop app that lets you
    pick a VGM file with a real file picker and play it live through CoreAudioOutput,
    instead of driving LivePlayer from the command line. See macos/README.md for how this
    fits into the overall port, and macos/MDPlayerCore/VgmEngine.cs / macos/CoreAudioOutput/
    for the engine/playback plumbing this reuses unchanged.

    IMPORTANT CAVEAT: this project was authored in a Linux sandbox with no network access
    to nuget.org (api.nuget.org returns 403 through the sandbox's allowlist proxy - verified
    directly), so none of Avalonia's packages could be restored, and not even a `dotnet
    build` compile-check was possible here, unlike every other project in this repo. The
    package names/versions and API usage below (StorageProvider file picker, AppBuilder,
    XAML structure) were checked against Avalonia's current documentation/source (12.1.1,
    as of 2026-08) via web search, but this is genuinely unverified code until it's
    actually restored and built on a machine with real internet access - i.e. the target
    Mac. Expect this to need a round of fixes after the first real build attempt.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>MDPlayerUI</AssemblyName>
    <RootNamespace>MDPlayer.UI</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Visualizer/PixelScreen.cs uses unsafe/fixed for a direct buffer-to-bitmap memcpy. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      Same reasoning as EngineSmokeTest.csproj/LivePlayer.csproj: the user's Mac only has
      .NET 10.0.7 installed (no exact 8.0.x runtime), so without RollForward the host
      refuses to launch with "You must install or update .NET".
    -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <!--
      Avalonia.Diagnostics (the F12 DevTools overlay) never shipped a 12.x release - its
      NuGet listing caps out at 11.3.20 and is marked deprecated in favor of
      AvaloniaUI.DiagnosticsSupport. Not essential for this milestone (open/play/stop a
      file), so just leaving DevTools out entirely rather than chasing the replacement
      package - can revisit if runtime debugging inside the app turns out to be useful.
    -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MDPlayerCore\MDPlayerCore.csproj" />
    <ProjectReference Include="..\CoreAudioOutput\CoreAudioOutput.csproj" />
  </ItemGroup>

  <!--
    Chip channel visualizer sprite sheets (see Visualizer/SpriteAtlas.cs's header comment
    for why these are a custom raw ".rgba32" format rather than PNGs decoded at runtime).
    AvaloniaResource embeds arbitrary files for avares:// lookup, not just recognized image
    formats, so the non-standard extension here is fine.
  -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!--
    Avalonia's macOS backend does not currently route AppKit's separate
    NSEventTypePressure (Force Touch) event. Build a tiny, app-local bridge
    rather than replacing Avalonia's full native backend.
  -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <None Include="$(IntermediateOutputPath)ForceTouch\libMDPlayerForceTouch.dylib"
          Link="libMDPlayerForceTouch.dylib"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildForceTouchMonitor"
          BeforeTargets="CoreCompile"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))"
          Inputs="$(MSBuildProjectDirectory)\Native\ForceTouchMonitor.m"
          Outputs="$(IntermediateOutputPath)ForceTouch\libMDPlayerForceTouch.dylib">
    <MakeDir Directories="$(IntermediateOutputPath)ForceTouch" />
    <Exec Command="xcrun clang -dynamiclib -arch arm64 -fobjc-arc -framework AppKit &quot;$(MSBuildProjectDirectory)/Native/ForceTouchMonitor.m&quot; -o &quot;$(IntermediateOutputPath)ForceTouch/libMDPlayerForceTouch.dylib&quot;" />
  </Target>

</Project>
