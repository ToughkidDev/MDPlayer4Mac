<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MDPlayer.UI.MainWindow"
        Title="MDPlayer4Mac"
        SizeToContent="WidthAndHeight"
        CanResize="True"
        DragDrop.AllowDrop="True">
    <!-- The final row is content-sized: a view switch therefore resizes the window down
         to the bottom of its playlist panel instead of leaving a star-row gap below it. -->
    <Grid x:Name="MainLayout" Margin="12,12,12,0" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
        <!-- File name and status share their right edge with the always-available master
             fader. Keeping it outside the transport dashboard leaves the button strip and
             timeline at their original widths. -->
        <Grid Grid.Row="0" Grid.RowSpan="2" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="4">
            <TextBlock x:Name="FileLabel" Grid.Row="0" Grid.Column="0" Text="파일을 선택하세요" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock x:Name="StatusLabel" Grid.Row="1" Grid.Column="0" Text="대기 중" Foreground="Gray" TextWrapping="Wrap" />
            <ContentControl x:Name="DashboardMasterVolumeHost" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                            VerticalAlignment="Top" HorizontalAlignment="Right" />
        </Grid>
        <!-- The two rows mirror frmMain's original transport / utility button placement. -->
        <Border x:Name="PlayerDashboard" Grid.Row="2" Background="Black" BorderBrush="#444" BorderThickness="1" Padding="4"
                DragDrop.AllowDrop="True">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Spacing="2">
                    <StackPanel x:Name="TransportButtonsHost" Orientation="Horizontal" Spacing="0" />
                    <StackPanel x:Name="UtilityButtonsHost" Orientation="Horizontal" Spacing="0" />
                </StackPanel>
                <!-- Windows frmMain keeps three counters (current/total/loop) next to the
                     controls and a timeline immediately beneath them. -->
                <Grid x:Name="DashboardTimelinePanel" Grid.Column="1" MinWidth="270" VerticalAlignment="Center" RowDefinitions="Auto,Auto" RowSpacing="5">
                    <!-- DashboardTimerDisplay draws its digits from the original Windows
                         rFont_01 sprite sheet rather than a platform text font. -->
                    <ContentControl x:Name="DashboardTimesHost" HorizontalAlignment="Center" />
                    <!-- A direct pixel track, rather than a themed ProgressBar: its width
                         stays exact when the channel view changes scale. -->
                    <Border x:Name="TimelineProgressTrack" Grid.Row="1" Height="8" HorizontalAlignment="Center"
                            Background="#171B2C" ClipToBounds="True">
                        <Border x:Name="TimelineProgressFill" Height="8" HorizontalAlignment="Left"
                                Background="#7887E8" />
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <!--
          ViewHost switches between the active chip's channel visualizer(s) and the native
          pixel-art mixer.  The latter uses the same rFader/rFont_03 assets and Windows
          frmMixer2 gain curve in long horizontal rows, while the channel view keeps its
          existing controls.
          Black matches both screens' original background.

          The window uses SizeToContent instead of a fixed Width/Height because which
          view shown and its height depend on the active chips, so a fixed window size would
          either clip a channel display or leave excess empty space around the mixer.
        -->
        <Border x:Name="ActiveViewPanel" Grid.Row="3" Background="Black" BorderBrush="Gray" BorderThickness="1" Padding="4">
            <ContentControl x:Name="ViewHost" />
        </Border>
        <Border x:Name="PlaylistPanel" IsVisible="False" Background="#111" BorderBrush="#555" BorderThickness="1"
                Grid.Row="4" Padding="6" DragDrop.AllowDrop="True" VerticalAlignment="Stretch">
            <Grid RowDefinitions="Auto,*" RowSpacing="4">
                <TextBlock x:Name="PlaylistHint" Grid.Row="0" Text="재생 목록 — 음악 파일을 여기 또는 창에 드롭하여 추가" Foreground="#D0D0D0" />
                <!-- Channel/mixer modes use a compact 3.5-row embedded playlist. -->
                <ListBox x:Name="PlaylistList" Grid.Row="1" Height="63" SelectionMode="Multiple"
                         SelectionChanged="OnPlaylistSelectionChanged"
                         DoubleTapped="OnPlaylistDoubleTapped" VerticalAlignment="Top">
                    <!-- The default Fluent list item carries generous touch padding. The
                         player uses a compact desktop playlist, so keep each row at about
                         half that vertical spacing. -->
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="6,1" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="FontFamily" Value="Consolas" />
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
