<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runtime smoke test for MDPlayerCore: loads a VGM file, drives the real Vgm
    driver + ChipRegister + MDSound chip emulation, and renders the result to a
    WAV file via the ported WaveWriter.cs. Exists to prove the ported engine
    doesn't just compile but actually produces correct audio - see
    macos/README.md's "다음 단계 후보" section for why this is the next milestone
    after MDPlayerCore's compile-only verification.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>EngineSmokeTest</AssemblyName>
    <RootNamespace>MDPlayer.EngineSmokeTest</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!--
      This is the only executable project in the repo (MDPlayerCore/MDSound are
      libraries, so this doesn't apply to them) - without RollForward, the .NET
      host requires the exact 8.0.x *runtime* to be installed side-by-side with
      whatever newer SDK/runtime is present, and fails with "You must install or
      update .NET" if only a later major version (e.g. 10.0.x) is on the machine.
      LatestMajor lets it run on any installed runtime >= 8.0, which is what we
      actually want here (we're not relying on any 8.0-specific runtime behavior).
    -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MDPlayerCore\MDPlayerCore.csproj" />
  </ItemGroup>

</Project>
